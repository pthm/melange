package studio

import "strings"

templ tuplesSidebar(types []typeCount, active string) {
	<div class="side-section">
		<div class="side-title">Types</div>
		if len(types) == 0 {
			<p class="mute side-title">No tuples.</p>
		}
		<ul class="side-list">
			for _, t := range types {
				<li>
					<a href={ templ.URL("/browse/" + t.Type) } { current(t.Type == active)... }>
						<span class="trunc" title={ t.Type }>{ t.Type }</span>
						<span class="t-mono mute">{ num(t.Count) }</span>
					</a>
				</li>
			}
		</ul>
	</div>
}

templ tuplesPage(env string, types []typeCount, errMsg string) {
	@shell(page{Env: env, Active: "tuples"}, tuplesSidebar(types, "")) {
		@pageHead("Tuples", nil) {
			<p class="page-meta">Browse every entity in <code>melange_tuples</code> and see what it can access and who can access it.</p>
		}
		if errMsg != "" {
			@errorBox(errMsg)
		}
		<section class="sec">
			@secHead("Types", num(len(types))) {
				<p class="help">Each type that appears in a tuple, as subject or object, with its number of distinct ids.</p>
			}
			<div class="sec-body">
				<ul class="rows">
					for _, t := range types {
						<li>
							<a class="row" href={ templ.URL("/browse/" + t.Type) }>
								<code>{ t.Type }</code>
								<span class="mute nowrap">{ plural(t.Count, "entity") }</span>
							</a>
						</li>
					}
				</ul>
			</div>
		</section>
	}
}

type browseData struct {
	Env    string
	Type   string
	Types  []typeCount
	Ents   []entityRef
	More   bool // more entities than the first page
	Total  int  // distinct ids of the type, from the sidebar counts
	Labels labels
	Source *labelSource // nil when the type has no label source
	Err    string
}

templ browsePage(d browseData) {
	@shell(page{Env: d.Env, Active: "tuples", Title: d.Type}, tuplesSidebar(d.Types, d.Type)) {
		@pageHead(d.Type, crumbs(d.Type, "")) {
			<p class="page-meta">
				if d.Source != nil {
					Names from <code>{ d.Source.Desc }</code>, { d.Source.Via }.
				} else {
					No label source found for this type, so entities show by id.
				}
			</p>
		}
		<section class="sec">
			@secHead("Entities", num(d.Total)) {
				<p class="help">Every <code>{ d.Type }</code> that appears in a tuple. Search matches ids and names.</p>
			}
			@filterBar(templ.Attributes{
				"name":        "q",
				"placeholder": "Search " + d.Type + " by id or name",
				"autofocus":   true,
				"hx-get":      "/browse/" + d.Type + "/list",
				"hx-trigger":  "input changed delay:250ms, search",
				"hx-target":   "#entities",
			})
			<div class="sec-body" id="entities" aria-live="polite">
				if d.Err != "" {
					@errorBox(d.Err)
				} else {
					@entityList(d.Ents, d.Labels, listPage{First: true, More: d.More, Next: browseNextURL(d.Type, "", pageSize)})
				}
			</div>
		</section>
	}
}

// crumbs renders Tuples › type [› current]; current empty makes type the page.
templ crumbs(typ, cur string) {
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/tuples">Tuples</a>
		<span aria-hidden="true">›</span>
		if cur == "" {
			<span aria-current="page">{ typ }</span>
		} else {
			<a href={ templ.URL("/browse/" + typ) }>{ typ }</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">{ cur }</span>
		}
	</nav>
}

// entityList is a page of a type's entities: the whole list on the first
// page, then rows appended by infinite scroll.
templ entityList(ents []entityRef, ls labels, p listPage) {
	if p.First {
		if len(ents) == 0 {
			<p class="mute">No matches.</p>
		}
		<ul class="rows">
			@entityRows(ents, ls, p)
		</ul>
	} else {
		@entityRows(ents, ls, p)
	}
}

templ entityRows(ents []entityRef, ls labels, p listPage) {
	for _, e := range ents {
		<li>
			<a class="row" href={ entityURL(e.Type, e.ID) }>
				@refLabel(e.Type, e.ID, ls)
				<span class="mute nowrap">{ plural(e.Count, "tuple") }</span>
			</a>
		</li>
	}
	@moreItem(p)
}

// directTable lists one side's tuples (the page's own entity is the fixed
// end, so only the relation and the other end show), first page only;
// directRows appends the rest. The other end is split into type, id and
// name columns so each lines up.
templ directTable(p directPage, ls labels) {
	if len(p.Tuples) == 0 {
		<p class="mute">None.</p>
	} else {
		<div class="scroll-x">
			<table class="direct">
				<thead>
					<tr>
						<th>relation</th>
						<th>
							if p.Side == sideObject {
								subject type
							} else {
								object type
							}
						</th>
						<th>id</th>
						<th>name</th>
					</tr>
				</thead>
				<tbody>
					@directRows(p, ls)
				</tbody>
			</table>
		</div>
	}
}

templ directRows(p directPage, ls labels) {
	for _, t := range p.Tuples {
		{{ typ, id, userset := t.ObjectType, t.ObjectID, "" }}
		if p.Side == sideObject {
			{{ typ = t.SubjectType }}
			{{ id, userset, _ = strings.Cut(t.SubjectID, "#") }}
		}
		{{ name := ls.of(typ, id) }}
		<tr>
			<td><code>{ t.Relation }</code></td>
			<td><span class="ent-type">{ typ }</span></td>
			<td>
				<a class="ent-link" href={ entityURL(typ, id) } title={ typ + ":" + id }><code class="trunc">{ id }</code></a>
				if userset != "" {
					<code class="mute">#{ userset }</code>
				}
			</td>
			<td class="cell-trunc mute" title={ name }>{ name }</td>
		</tr>
	}
	@moreRow(listPage{More: p.More, Next: p.Next}, 4)
}

// refLink links an entity: its type:id first, then its label when one
// resolved, as context. The tuple identity always leads.
templ refLink(typ, id string, ls labels) {
	<a class="ent-link" href={ entityURL(typ, id) }>
		@refLabel(typ, id, ls)
	</a>
}

// refLabel is refLink's content, for rows that are links themselves. Long
// ids and labels are cut off with an ellipsis; the title has both in full.
templ refLabel(typ, id string, ls labels) {
	{{ l := ls.of(typ, id) }}
	<span class="ent" title={ refTitle(typ, id, l) }>
		<span class="ent-key"><span class="ent-type">{ typ }</span><code>{ id }</code></span>
		if l != "" {
			<span class="ent-name">{ l }</span>
		}
	</span>
}
