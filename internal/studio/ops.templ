package studio

import (
	"fmt"

	"github.com/pthm/melange/internal/doctor"
)

// historySidebar is the migration picker: each row has its number, time
// and version, then what changed in its schema at a glance.
templ historySidebar(d historyData) {
	<div class="side-section">
		<div class="side-title">Migrations</div>
		<ul class="side-list mig-list">
			for i, e := range d.Entries {
				<li>
					<a href={ templ.URL(fmt.Sprintf("/history?id=%d", e.Rec.ID)) } { current(i == d.Sel)... }>
						<span class="mig">
							<span class="mig-id">#{ fmt.Sprint(e.Rec.ID) }</span>
							<span class="mig-time">{ e.Rec.MigratedAt.UTC().Format("2 Jan, 15:04") }</span>
							<span class="mig-badge">
								if e.Deployed {
									<span class="badge ok">deployed</span>
								}
							</span>
							<span class="mig-sub">
								switch  {
									case e.Unchanged != 0:
										schema unchanged
									case e.RevertOf != 0:
										reverts to #{ fmt.Sprint(e.RevertOf) }
									default:
										if e.Stats.Lines {
											@diffStat(e.Stats)
										}
										{ shortSummary(e.Stats) }
								}
							</span>
							<span class="mig-badge">
								if e.Stats.Breaking > 0 && e.RevertOf == 0 {
									<span class="badge warn" title={ plural(e.Stats.Breaking, "breaking change") }>{ num(e.Stats.Breaking) } breaking</span>
								}
							</span>
						</span>
					</a>
				</li>
			}
		</ul>
	</div>
}

templ historyPage(d historyData) {
	@shell(page{Env: d.Env, Active: "history"}, historySidebar(d)) {
		if d.Sel < 0 {
			@pageHead("History", nil) {
				<p class="page-meta">Every recorded run of <code>melange migrate</code>, from <code>melange_migrations</code>.</p>
			}
			if d.Err != "" {
				@errorBox(d.Err)
			} else {
				<section class="sec"><div class="sec-body mute">No migrations recorded.</div></section>
			}
		} else {
			@migrationDetail(d, d.Entries[d.Sel])
		}
	}
}

// migrationDetail is one migration: when and by what it ran, how its schema
// changed (as counts, model changes and a line diff), then its record.
templ migrationDetail(d historyData, e historyEntry) {
	{{ st := e.Stats }}
	@pageHead(fmt.Sprintf("Migration #%d", e.Rec.ID), nil) {
		<p class="page-meta">
			Ran { e.Rec.MigratedAt.UTC().Format("Mon 2 Jan 2006, 15:04:05 MST") }.
			if e.Deployed {
				The database runs this migration's model.
			}
		</p>
		<nav class="mig-nav" aria-label="Neighbouring migrations">
			if d.Sel+1 < len(d.Entries) {
				<a href={ templ.URL(fmt.Sprintf("/history?id=%d", d.Entries[d.Sel+1].Rec.ID)) }>← #{ fmt.Sprint(d.Entries[d.Sel+1].Rec.ID) } older</a>
			}
			if d.Sel > 0 {
				<a href={ templ.URL(fmt.Sprintf("/history?id=%d", d.Entries[d.Sel-1].Rec.ID)) }>newer #{ fmt.Sprint(d.Entries[d.Sel-1].Rec.ID) } →</a>
			}
		</nav>
		<div class="stats">
			if e.Unchanged == 0 && st.Lines {
				@statText(signed(st.LinesAdded, st.LinesRemoved), "lines", "")
			}
			if e.Unchanged == 0 && st.Model {
				@statText(signed(st.TypesAdded, st.TypesRemoved), "types", "")
				@statText(signed(st.RelsAdded, st.RelsRemoved)+changedSuffix(st.RelsChanged), "relations", "")
				@statText(num(st.Breaking), "breaking", breakingTone(st.Breaking))
			}
			@statText(num(len(e.Rec.FunctionNames)), "functions", "")
		</div>
	}
	if d.Err != "" {
		@errorBox(d.Err)
	}
	<section class="sec">
		@secHead("Changes", "") {
			<p class="help">
				switch  {
					case d.Prev == nil:
						The first recorded migration: nothing to compare with.
					case e.Unchanged != 0:
						The schema is identical to #{ fmt.Sprint(e.Unchanged) }; this run regenerated the functions{ codegenNote(d, e) }.
					case e.RevertOf != 0:
						The schema is identical to #{ fmt.Sprint(e.RevertOf) }: this migration reverted the changes made since.
					default:
						From #{ fmt.Sprint(d.Prev.ID) } to #{ fmt.Sprint(e.Rec.ID) }. Breaking changes narrow access or remove structure; additive ones don't.
				}
			</p>
		}
		if d.Prev != nil && e.Unchanged == 0 {
			<div class="sec-body stack">
				if len(st.Changes) > 0 {
					@modelChanges(groupChanges(st.Changes))
				} else if st.Model {
					<p class="mute">No model changes: only comments or formatting differ.</p>
				}
				if d.Prev.DSL != "" && d.Cur.DSL != "" {
					for _, f := range schemaFileDiffs(d.Prev.DSL, d.Cur.DSL, d.Cur.Modular) {
						<pre class="code diff">
							for _, row := range diffRows(f) {
								<span class={ row.Class }>{ row.Text }</span>
							}
						</pre>
					}
				} else {
					<p class="mute">One of these migrations didn't record its schema, so there is no line diff.</p>
				}
			</div>
		}
	</section>
	<section class="sec">
		@secHead("Record", "") {
			<p class="help">The row in <code>melange_migrations</code>.</p>
		}
		<div class="sec-body stack">
			<dl class="kv">
				<dt>status</dt>
				<dd>
					if e.Deployed {
						<span class="badge ok">deployed</span>
					} else {
						<span class="mute">superseded by a later migration</span>
					}
				</dd>
				<dt>melange</dt>
				<dd><code>{ e.Rec.MelangeVersion }</code></dd>
				<dt>codegen</dt>
				<dd><code>{ e.Rec.CodegenVersion }</code></dd>
				<dt>schema checksum</dt>
				<dd><code>{ e.Rec.SchemaChecksum }</code></dd>
				<dt>functions</dt>
				<dd>{ num(len(e.Rec.FunctionNames)) }</dd>
				<dt>schema</dt>
				<dd>
					if e.Rec.SchemaFormat != "" {
						recorded ({ e.Rec.SchemaFormat })
					} else if d.Cur.DSL != "" {
						recorded
					} else {
						<span class="mute">not recorded (migrated before melange stored deployed models)</span>
					}
				</dd>
			</dl>
			if d.Cur.DSL != "" {
				<h3 class="sub-title">Schema</h3>
				@fgaSource(d.Cur.DSL)
			}
		</div>
	</section>
}

// modelChanges lists a migration's model changes by type and relation: one
// row per relation, its lost (−) and gained (+) terms, and a breaking marker
// in a column of its own.
templ modelChanges(groups []changeGroup) {
	<div class="chg">
		for _, g := range groups {
			<div class="chg-type">
				<h3>
					<code>{ g.Type }</code>
					switch g.Status {
						case "added":
							<span class="chg-status add">new type</span>
						case "removed":
							<span class="chg-status del">type removed</span>
					}
				</h3>
				if len(g.Relations) > 0 {
					<ul class="chg-rels">
						for _, r := range g.Relations {
							<li>
								<code class="chg-rel">{ r.Name }</code>
								<span class="chg-items">
									switch r.Status {
										case "added":
											<span class="chg-status add">added</span>
										case "removed":
											<span class="chg-status del">removed</span>
										default:
											for _, it := range r.Items {
												<span class={ "chg-item", signClass(it.Sign) }>{ it.Sign } { it.Text }</span>
											}
									}
								</span>
								<span class="chg-flag">
									if r.Breaking {
										breaking
									}
								</span>
							</li>
						}
					</ul>
				}
			</div>
		}
	</div>
}

// statText is stat for a preformatted value, like "+3 −1".
templ statText(value, label, tone string) {
	<div class={ "stat", tone }><span class="t-heading">{ value }</span>{ label }</div>
}

// diffStat is a migration's changed line counts, like "+12 −3".
templ diffStat(st migrationStats) {
	<span class="diffstat t-mono" title={ fmt.Sprintf("%s added, %s removed", plural(st.LinesAdded, "line"), plural(st.LinesRemoved, "line")) }>
		if st.LinesAdded > 0 {
			<span class="add">+{ num(st.LinesAdded) }</span>
		}
		if st.LinesRemoved > 0 {
			<span class="del">−{ num(st.LinesRemoved) }</span>
		}
	</span>
}

templ healthSidebar(cats []healthCategory) {
	<div class="side-section">
		<div class="side-title">Checks</div>
		<ul class="side-list">
			for _, c := range cats {
				<li>
					<a href={ templ.URL("#" + anchor(c.Name)) }>
						{ c.Name }
						<span class={ "badge", statusClass(c.Worst) }>{ num(len(c.Checks)) }</span>
					</a>
				</li>
			}
		</ul>
	</div>
}

templ healthPage(env, schemaPath string, report *doctor.Report, errMsg string) {
	{{ cats := groupChecks(report) }}
	@shell(page{Env: env, Active: "health"}, healthSidebar(cats)) {
		@pageHead("Health", nil) {
			<p class="page-meta">The checks <code>melange doctor</code> runs against this database.</p>
			if report != nil {
				<div class="stats">
					@stat(report.Passed, "passed", "ok")
					@stat(report.Warnings, "warnings", "warn")
					@stat(report.Errors, "errors", "fail")
				</div>
			}
		}
		if errMsg != "" {
			@errorBox(errMsg)
		}
		if schemaPath == "" {
			<div class="content-note">
				@noticeBox("No local schema file", "No local schema file is configured, so the file and drift checks are skipped. Pass --schema to run them.")
			</div>
		}
		<div class="stack">
			for _, c := range cats {
				<section class="sec" id={ anchor(c.Name) }>
					@secHead(c.Name, num(len(c.Checks))) {
						if c.Name == "Generated Functions" {
							<p class="help">
								Compared with the local schema file. The <a href="/sql">SQL API</a> page compares the deployed model instead, so the two differ while a migration is pending.
								if schemaPath != "" {
									Local schema: <code>{ schemaPath }</code>.
								}
							</p>
						}
					}
					<div class="sec-body">
						<ul class="rows">
							for _, chk := range c.Checks {
								<li class="check">
									<span class={ "badge", statusClass(chk.Status) }>{ statusLabel(chk.Status) }</span>
									<div>
										{ chk.Message }
										if chk.Details != "" || chk.FixHint != "" {
											<div class="detail">
												if chk.Details != "" {
													<pre>{ chk.Details }</pre>
												}
												if chk.FixHint != "" {
													<span class="mute">Fix: <code>{ chk.FixHint }</code></span>
												}
											</div>
										}
									</div>
								</li>
							}
						</ul>
					</div>
				</section>
			}
		</div>
	}
}
