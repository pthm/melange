package studio

import (
	"cmp"
	"fmt"
	"strings"

	"github.com/pthm/melange/pkg/compiler"
)

templ relationPage(d relationData) {
	@shell(page{Env: d.Env, Active: "model", Title: d.Type + "#" + d.Relation}, modelSidebar(indexData{Model: d.Model, Type: d.Type, Relation: d.Relation})) {
		@pageHead(cmp.Or(d.Relation, "Relation"), modelCrumbs(d.Type)) {
			// The old sidebar behaviour: prefill the Model page query form.
			if d.Known {
				<form class="head-actions" action="/" method="get">
					<input type="hidden" name="type" value={ d.Type }/>
					<input type="hidden" name="relation" value={ d.Relation }/>
					<button type="submit" title="Fill in the Model page query form with this relation">Query</button>
				</form>
			}
			if d.Known {
				<p class="page-meta">Its definition, what it reads and what reads it, and the SQL generated for it.</p>
			}
		}
		<div>
			if d.Err != "" {
				<section class="sec">
					<div class="sec-body">
						@errorBox(d.Err)
					</div>
				</section>
			}
			if len(d.Unavailable) > 0 || len(d.OnDemand) > 0 {
				<section class="sec">
					@secHead("SQL API", "") {
						<p class="help">What the database's public functions answer for this relation, under the exposure the last migration recorded. <a href={ sqlRelationURL(d.Type, d.Relation) }>SQL API</a> has the calls that work.</p>
					}
					<div class="sec-body">
						<dl class="kv api-avail">
							for _, g := range groupUnavailable(d.Unavailable, unavailableFamily, d.Type+"#"+d.Relation) {
								<dt><span class="badge">{ g.Label }</span></dt>
								<dd>
									{ strings.Join(g.Items, ", ") } <span class="mute">{ familiesSay(g) }</span>
									@unavailableReasons(g.Reasons)
								</dd>
							}
							if len(d.OnDemand) > 0 {
								<dt><span class="badge">on demand</span></dt>
								<dd>{ strings.Join(d.OnDemand, ", ") } <span class="mute">not installed; Studio and the CLI compile them into pg_temp for each call</span></dd>
							}
						</dl>
					</div>
				</section>
			}
			if d.Define != "" {
				<section class="sec">
					@secHead("Definition", "") {
						<p class="help">
							From the deployed schema.
							if d.Model != nil {
								Migrated { d.Model.MigratedAt.UTC().Format("2 Jan 2006, 15:04 MST") } by melange <code>{ d.Model.MelangeVersion }</code>.
							}
						</p>
					}
					<div class="sec-body">
						@fgaSource(d.Define)
					</div>
				</section>
			}
			if d.Analysis != nil {
				@relationAnalysis(d.Type, d.Analysis)
			}
			if d.Model != nil && d.Err == "" {
				@relationEdges("Depends on", dependsOnHelp(d.DependsOn), d.DependsOn, "Nothing: only direct tuples grant it.")
				@relationEdges("Used by", "Relations that read this one.", d.UsedBy, "No other relation reads it.")
			}
			if d.Known {
				<section class="sec">
					@secHead("Generated SQL", num(len(d.Funcs))) {
						<p class="help">
							The functions the deployed SQL API installs for this relation, read back from PostgreSQL; this is what runs.
							The dispatchers route <code>check_permission</code> and the list functions here.
							if d.Model != nil {
								<a href={ sqlRelationURL(d.Type, d.Relation) }>SQL API</a> has their signatures, example calls and status.
							}
						</p>
					}
					<div class="sec-body stack">
						if d.FuncErr != "" {
							@errorBox(d.FuncErr)
						} else if len(d.Funcs) == 0 {
							<p class="mute">No functions for this relation are installed in the database.</p>
						}
						if d.API != nil {
							@notInstalledList(d.API.NotInstalled)
						}
						for _, f := range d.Funcs {
							<details class="disclose">
								<summary>
									<code>{ f.Name }</code>
									<span class="mute">· { f.Label } · { plural(strings.Count(f.Def, "\n"), "line") }</span>
								</summary>
								@sqlSource(f.Def)
							</details>
						}
					</div>
				</section>
			}
		</div>
	}
}

// modelCrumbs renders Model › type above a relation's title.
templ modelCrumbs(typ string) {
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Model</a>
		if typ != "" {
			<span aria-hidden="true">›</span>
			<span>{ typ }</span>
		}
	</nav>
}

templ relationAnalysis(typ string, a *compiler.RelationAnalysis) {
	<section class="sec">
		@secHead("Features", "") {
			<p class="help">As the code generator sees the relation after resolving implied relations, so a relation can inherit flags (such as wildcard) from the ones that imply it.</p>
		}
		<div class="sec-body">
			<dl class="kv">
				<dt>features</dt>
				<dd class="inline-gap">
					for _, f := range features(a) {
						<span class="badge accent">{ f }</span>
					}
					if len(features(a)) == 0 {
						<span class="mute">none</span>
					}
				</dd>
				<dt>check</dt>
				<dd>
					if a.Capabilities.CheckAllowed {
						<span class="badge ok">specialized</span>
					} else {
						<span class="badge warn">not generated</span> <span class="mute">{ a.Capabilities.CheckReason }</span>
					}
				</dd>
				<dt>list</dt>
				<dd>
					if a.Capabilities.ListAllowed {
						<span class="badge ok">specialized</span> <span class="mute">strategy</span> <code>{ a.ListStrategy.String() }</code>
					} else {
						<span class="badge warn">not generated</span> <span class="mute">{ a.Capabilities.ListReason }</span>
					}
				</dd>
				<dt>satisfied by</dt>
				<dd class="inline-gap">
					for _, s := range a.SatisfyingRelations {
						<a href={ relationURL(typ, s) }><code>{ s }</code></a>
					}
				</dd>
				if a.MaxUsersetDepth > 0 {
					<dt>userset depth</dt>
					<dd>
						{ fmt.Sprint(a.MaxUsersetDepth) }
						if a.ExceedsDepthLimit {
							<span class="badge fail">exceeds limit</span>
						}
					</dd>
				}
			</dl>
		</div>
	</section>
}

templ relationEdges(title, help string, edges []relEdge, empty string) {
	<section class="sec">
		@secHead(title, num(len(edges))) {
			<p class="help">{ help }</p>
		}
		<div class="sec-body">
			if len(edges) == 0 {
				<p class="mute">{ empty }</p>
			} else {
				@edgeRows(headN(edges, edgeShow))
				// A hub relation can have hundreds of edges; keep Generated SQL in reach.
				if len(edges) > edgeShow {
					<details class="more disclose">
						<summary>Show { num(len(edges) - edgeShow) } more</summary>
						@edgeRows(edges[edgeShow:])
					</details>
				}
			}
		</div>
	</section>
}

templ edgeRows(edges []relEdge) {
	<ul class="rows">
		for _, e := range edges {
			<li>
				<a class="row" href={ relationURL(e.Type, e.Relation) }>
					<code>{ e.Type }#{ e.Relation }</code>
					<span>
						for _, k := range e.Kinds {
							<span class="kind">{ k }</span>
						}
					</span>
				</a>
			</li>
		}
	</ul>
}
