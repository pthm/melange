package studio

import (
	"strings"

	"github.com/pthm/melange/internal/sqlapi"
	"github.com/pthm/melange/internal/sqlgen"
)

templ sqlAPIPage(d sqlAPIData) {
	@shell(page{Env: d.Env, Active: "sql", Title: sqlAPITitle(d)}, sqlAPISidebar(d)) {
		@pageHead("SQL API", nil) {
			<p class="page-meta">
				The functions the deployed model installs under the exposure its last migration recorded, with their exact names (long ones are truncated to 63 bytes with a hash), compared with <code>pg_proc</code> in schema <code>{ d.Schema }</code>.
				<code>melange functions --db</code> prints the same report.
				<a href="/health">Health</a> runs <code>melange doctor</code>, which compares the local schema file instead.
			</p>
			if d.Report != nil {
				<p class="page-meta">Exposure: <code>{ exposureText(d.Report.Exposure) }</code></p>
				<div class="stats">
					@stat(d.Report.Summary.Functions, "functions", "")
					@stat(d.Report.Summary.Installed, "installed", "ok")
					@stat(d.driftCount(), "drifted", "warn")
					@stat(d.Report.Summary.Exposed, "exposed relations", "")
				</div>
			}
		}
		if d.Err != "" {
			@errorBox(d.Err)
		}
		if d.Report != nil {
			if d.Type == "" && d.Kind == "" {
				@sqlAPIOverview(d)
			} else {
				@sqlAPIRelations(d)
			}
		}
	}
}

func sqlAPITitle(d sqlAPIData) string {
	switch {
	case d.Type != "" && d.Kind != "":
		return "SQL API: " + d.Type + ", " + d.Kind
	case d.Type != "":
		return "SQL API: " + d.Type
	case d.Kind != "":
		return "SQL API: " + d.Kind
	}
	return "SQL API"
}

templ sqlAPISidebar(d sqlAPIData) {
	<div class="side-section">
		<ul class="side-list">
			<li><a href="/sql" { current(d.Type == "" && d.Kind == "")... }>Overview</a></li>
		</ul>
	</div>
	<div class="side-section">
		<div class="side-title">Kinds</div>
		<ul class="side-list">
			<li><a href={ sqlAPIURL(d.Type, "") } { current(d.Type != "" && d.Kind == "")... }>all kinds</a></li>
			for _, k := range sqlgen.FunctionKinds {
				if k != sqlgen.KindDispatcher {
					<li><a href={ sqlAPIURL(d.Type, string(k)) } { current(d.Kind == string(k))... }>{ string(k) }</a></li>
				}
			}
		</ul>
	</div>
	if len(d.Types) > 0 {
		<div class="side-section">
			<div class="side-title">Types <span class="mute">(exposed of relations)</span></div>
			<ul class="side-list">
				<li><a href={ sqlAPIURL("", d.Kind) } { current(d.Type == "" && d.Kind != "")... }>all types</a></li>
				for _, t := range d.Types {
					<li>
						<a href={ sqlAPIURL(t.Name, d.Kind) } { current(d.Type == t.Name)... }>
							{ t.Name }
							<span class="t-mono mute">{ num(t.Exposed) }/{ num(t.Relations) }</span>
						</a>
					</li>
				}
			</ul>
		</div>
	}
}

// sqlAPIOverview is what drifted, the dispatchers, and the name collisions.
templ sqlAPIOverview(d sqlAPIData) {
	{{ r := d.Report }}
	<div class="stack">
		<section class="sec" id="drift">
			@secHead("Drift", num(d.driftCount())) {
				<p class="help">Expected functions that are missing, installed with other arguments or another body, or that have stale overloads, and orphans the last migration recorded. Each says how to fix it.</p>
			}
			<div class="sec-body stack">
				if len(d.Drifted) == 0 && len(r.Orphans) == 0 {
					<p class="mute">None: every expected function is installed as this melange generates it.</p>
				} else {
					<ul class="rows">
						for _, f := range d.Drifted {
							<li class="check">
								@statusBadgeOf(f.Status)
								<div>
									<code>{ f.Name }</code>
									<span class="mute">· { kindLabel(f.CatalogFunction) }</span>
									if f.Type != "" {
										<a href={ sqlRelationURL(f.Type, f.Relation) }><code>{ f.Type }#{ f.Relation }</code></a>
									}
									if f.Detail != "" {
										<div class="detail mute">{ f.Detail }</div>
									}
									if len(f.StaleOverloads) > 0 {
										<div class="detail mute">Stale overloads: <code>{ strings.Join(f.StaleOverloads, "; ") }</code></div>
									}
								</div>
							</li>
						}
						for _, o := range r.Orphans {
							<li class="check">
								<span class="badge warn">orphan</span>
								<div>
									<code>{ o.Name }({ o.Arguments })</code>
									if r.CodegenAhead {
										<span class="mute">· recorded by the last migration, run by a newer melange; this melange does not generate it</span>
									} else {
										<span class="mute">· recorded by the last migration, no longer generated</span>
									}
								</div>
							</li>
						}
					</ul>
				}
				if len(r.Unmanaged) > 0 {
					<details class="disclose">
						<summary>{ plural(len(r.Unmanaged), "unmanaged function") } <span class="mute">named like generated ones, recorded by no migration; migrate never drops them</span></summary>
						<ul class="rows">
							for _, u := range r.Unmanaged {
								<li><code>{ u.Name }({ u.Arguments })</code></li>
							}
						</ul>
					</details>
				}
				for _, n := range r.Notes {
					<p class="mute">{ n }</p>
				}
			</div>
		</section>
		if len(r.Collisions) > 0 {
			<section class="sec" id="collisions">
				@secHead("Name collisions", num(len(r.Collisions))) {
					<p class="help">Names generated for more than one relation. CREATE OR REPLACE keeps the last, so the others answer with another relation's function. Rename one of them.</p>
				}
				<div class="sec-body">
					<ul class="rows">
						for _, c := range r.Collisions {
							<li><code>{ c.Name }</code> <span class="mute">{ strings.Join(c.Owners, ", ") }</span></li>
						}
					</ul>
				</div>
			</section>
		}
		<section class="sec" id="dispatchers">
			@secHead("Dispatchers", num(len(r.Dispatchers))) {
				<p class="help">The entry points that take the type and relation as arguments, and the internal ones generated functions call. Pick a type or a kind for the per-relation functions.</p>
			}
			<div class="sec-body stack">
				for _, f := range r.Dispatchers {
					@sqlFunction(f, len(f.Answers))
				}
			</div>
		</section>
	</div>
}

// sqlAPIRelations lists the selected relations, exposed ones first and the
// internal ones folded away.
templ sqlAPIRelations(d sqlAPIData) {
	<section class="sec">
		@secHead("Exposed relations", num(len(d.Exposed))) {
			<p class="help">The public dispatchers answer for these.</p>
		}
		@filterBar(templ.Attributes{"placeholder": "Filter relations and functions", "data-filter": "#sql-rels"})
		<div class="sec-body stack" id="sql-rels">
			if len(d.Exposed) == 0 {
				<p class="mute">None.</p>
			}
			for _, rel := range d.Exposed {
				@sqlRelation(rel)
			}
			if len(d.Internal) > 0 {
				<details class="disclose" data-group>
					<summary>{ plural(len(d.Internal), "internal relation") } <span class="mute">not exposed (modelling only): installed when an exposed relation resolves through them; the public dispatchers raise M2003 for them, except expand_permission for the installed ones</span></summary>
					<div class="stack">
						for _, rel := range d.Internal {
							@sqlRelation(rel)
						}
					</div>
				</details>
			}
		</div>
		<p class="mute" data-empty-filter="#sql-rels" hidden>No matches.</p>
	</section>
}

templ sqlRelation(rel sqlapi.Relation) {
	<div class="sql-rel" id={ relAnchor(rel.Type, rel.Relation) } data-item data-text={ sqlRelationText(rel) }>
		<p>
			<a href={ relationURL(rel.Type, rel.Relation) }><code>{ rel.Type }#{ rel.Relation }</code></a>
			if rel.Exposed {
				<span class="badge ok">exposed</span>
			} else {
				<span class="badge">internal</span>
			}
			if len(rel.Dispatchers) > 0 {
				<span class="mute">answered by { strings.Join(rel.Dispatchers, ", ") }</span>
			}
		</p>
		for _, f := range rel.Functions {
			@sqlFunction(f, -1)
		}
		@notInstalledList(rel.NotInstalled)
	</div>
}

// notInstalledList says why each function family a relation could have is
// not installed; nothing when every one is.
templ notInstalledList(ns []sqlgen.NotInstalled) {
	if len(ns) > 0 {
		<ul class="rows mute">
			for _, n := range ns {
				<li><code>{ string(n.Kind) }</code> not installed, { reasonLabel(n.Reason) }: { n.Detail }</li>
			}
		</ul>
	}
}

// sqlRelationText is what the filter matches a relation by.
func sqlRelationText(rel sqlapi.Relation) string {
	parts := []string{rel.Type + "#" + rel.Relation}
	for _, f := range rel.Functions {
		parts = append(parts, f.Name)
	}
	return strings.Join(parts, " ")
}

// sqlFunction is one function, folded to its name, kind and status.
// answers is a dispatcher's relation count, or -1.
templ sqlFunction(f sqlapi.Function, answers int) {
	<details class="disclose">
		<summary>
			<code>{ f.Name }</code>
			@statusBadgeOf(f.Status)
			<span class="mute">· { kindLabel(f.CatalogFunction) } · { visibility(f.Public) }</span>
			if f.Truncated {
				<span class="badge" title="Truncated to 63 bytes with a hash of the type and relation">truncated</span>
			}
			if answers >= 0 {
				<span class="mute">· answers for { plural(answers, "relation") }</span>
			}
		</summary>
		<dl class="kv">
			<dt>signature</dt>
			<dd>
				<code>{ f.Name }{ f.Signature.String() }</code>
				<span class="mute">LANGUAGE { f.Signature.Language }</span>
				if f.Signature.Paged {
					<span class="mute">· paged</span>
				}
			</dd>
			if f.Link != "" {
				<dt>link</dt>
				<dd><code>{ f.Link }</code> → <code>{ f.ParentType }</code>, reads <code>{ strings.Join(f.ParentRelations, ", ") }</code></dd>
			}
			if f.Example != "" {
				<dt>example</dt>
				<dd class="copyable"><code>{ f.Example }</code> <button type="button" class="copy" data-copy={ f.Example }>Copy</button></dd>
			}
			if f.Usage != "" {
				<dt>usage</dt>
				<dd class="copyable"><code>{ f.Usage }</code> <button type="button" class="copy" data-copy={ f.Usage }>Copy</button></dd>
			}
			if len(f.Calls) > 0 {
				<dt>may call</dt>
				<dd><code>{ strings.Join(f.Calls, ", ") }</code></dd>
			}
			if f.RenderedWith != "" {
				<dt>created with</dt>
				<dd><code>{ f.RenderedWith }</code></dd>
			}
			if f.Note != "" {
				<dt>note</dt>
				<dd>{ f.Note }</dd>
			}
			if f.Detail != "" {
				<dt>status</dt>
				<dd>{ f.Detail }</dd>
			}
			if len(f.StaleOverloads) > 0 {
				<dt>stale overloads</dt>
				<dd><code>{ strings.Join(f.StaleOverloads, "; ") }</code></dd>
			}
		</dl>
	</details>
}

templ statusBadgeOf(st sqlapi.Status) {
	{{ class, label := statusBadge(st) }}
	<span class={ "badge", class }>{ label }</span>
}
